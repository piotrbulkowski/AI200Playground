# Copy to .env and adjust. Never commit the real .env.
ENVIRONMENT=development

# Azure Storage — auth is always DefaultAzureCredential (az login locally), never a key/connection string.
AZURE_STORAGE_ACCOUNT_URL=https://ai200playgrounddev.blob.core.windows.net
AZURE_STORAGE_CONTAINER=documents

# Postgres — local Docker Compose instance.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ai200_dev
POSTGRES_USER=ai200
POSTGRES_PASSWORD=ai200
POSTGRES_POOL_MIN_SIZE=1
POSTGRES_POOL_MAX_SIZE=10

# Upload validation
UPLOAD_MAX_SIZE_MB=50
ALLOWED_CONTENT_TYPES=application/pdf,text/plain,text/markdown,application/json
